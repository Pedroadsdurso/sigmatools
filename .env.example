# ---------------------------------------------------------------------------
# OnyxPag — gateway de pagamento PIX
# Docs: https://doc.onyxpag.com/
#
# A OnyxPag autentica com Basic auth usando base64("<pk>:<sk>").
# Como a chave secreta entra em TODA chamada, nenhuma das duas pode ir para o
# browser. Por isso nenhuma variavel aqui usa o prefixo NEXT_PUBLIC_ — todas sao
# lidas exclusivamente em codigo server-side (Route Handlers / Server Actions).
# ---------------------------------------------------------------------------

ONYXPAG_API_URL=https://api.onyxpag.com
ONYXPAG_PUBLIC_KEY=YOUR_ONYXPAG_PUBLIC_KEY_HERE
ONYXPAG_SECRET_KEY=YOUR_ONYXPAG_SECRET_KEY_HERE

# URL publica do site. Usada em dois lugares obrigatorios da API OnyxPag:
#   - source_url   : identifica a pagina de checkout que originou a cobranca
#   - postbackUrl  : recebe os webhooks de mudanca de status (transaction.paid)
# Em producao aponte para o dominio real (https://sigmatools.site).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo compartilhado para validar que um POST em /api/checkout/webhook
# veio mesmo da OnyxPag, e nao de um terceiro que descobriu a rota.
ONYXPAG_WEBHOOK_SECRET=troque-por-um-valor-aleatorio-longo

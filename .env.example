# ---------------------------------------------------------------------------
# OnyxPag — gateway de pagamento PIX
# Docs: https://doc.onyxpag.com/
#
# A OnyxPag autentica com Basic auth usando base64("<pk>:<sk>").
# Como a chave secreta entra em TODA chamada, nenhuma das duas pode ir para o
# browser. Por isso nenhuma variavel aqui usa o prefixo NEXT_PUBLIC_ — todas sao
# lidas exclusivamente em codigo server-side (Route Handlers / Server Actions).
# ---------------------------------------------------------------------------

ONYXPAG_API_URL=https://api.onyxpag.com
ONYXPAG_PUBLIC_KEY=YOUR_ONYXPAG_PUBLIC_KEY_HERE
ONYXPAG_SECRET_KEY=YOUR_ONYXPAG_SECRET_KEY_HERE

# URL publica do site. Usada em dois lugares obrigatorios da API OnyxPag:
#   - source_url   : identifica a pagina de checkout que originou a cobranca
#   - postbackUrl  : recebe os webhooks de mudanca de status (transaction.paid)
# Em producao aponte para o dominio real (https://sigmatools.site).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo compartilhado para validar que um POST em /api/checkout/webhook
# veio mesmo da OnyxPag, e nao de um terceiro que descobriu a rota.
ONYXPAG_WEBHOOK_SECRET=troque-por-um-valor-aleatorio-longo

# ---------------------------------------------------------------------------
# PrimeCash — gateway de pagamento CARTAO DE CREDITO (independente do Pix)
# Docs: https://primecashbrasil.readme.io/reference/introducao
#
# A PrimeCash autentica com Basic auth usando base64("<secret>:x"). A chave
# secreta entra em TODA chamada e NUNCA pode ir para o browser — por isso e
# lida so em codigo server-side e nao usa o prefixo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Chave SECRETA (server-side). Obrigatoria para cobrar no cartao.
SECRET_TOKEN_PRIME_CASH=YOUR_PRIMECASH_SECRET_TOKEN_HERE

# (Opcional) Sobrescreve a URL base da API da PrimeCash.
# PRIMECASH_API_URL=https://api.primecashbrasil.com/v1

# (Opcional) Sobrescreve a chave PUBLICA usada na tokenizacao no navegador.
# Se ausente, usa a chave embutida em src/lib/primecash-public.ts.
# NEXT_PUBLIC_PRIMECASH_PUBLIC_KEY=pk_live_...

# Segredo compartilhado para validar o postback da PrimeCash em
# /api/checkout/card/webhook. Recomendado em producao.
PRIMECASH_WEBHOOK_SECRET=troque-por-um-valor-aleatorio-longo

# ---------------------------------------------------------------------------
# Magnus Frete — pos-venda (rastreio + atualizacoes ao lead)
# So e acionada em pagamentos APROVADOS no CARTAO. O Pix ja tem o proprio fluxo.
# ---------------------------------------------------------------------------

# (Opcional) Endpoint da API externa da Magnus. Tem fallback no codigo.
# MAGNUS_FRETE_ENDPOINT=https://wzxfbejykayahnfdkdbl.supabase.co/functions/v1/api-external

# (Opcional) Token da loja na Magnus (?token=...). Tem fallback no codigo.
# MAGNUS_FRETE_TOKEN=seu-token-da-magnus
